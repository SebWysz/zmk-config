#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

// Helpful editor https://nickcoutsos.github.io/keymap-editor/

/ {
        keymap {
                compatible = "zmk,keymap";

                default_layer {
// -----------------------------------------------------------------------------------------
// | TAB      |  Q  |  W  |  E  |  R  |  T  |         |  Y  |  U   |  I  |  O  |  P  |  \  |
// | CTRL/ESC |  A  |  S  |  D  |  F  |  G  |         |  H  |  J   |  K  |  L  |  ;  |  '  |
// | SHFT     |  Z  |  X  |  C  |  V  |  B  |         |  N  |  M   |  ,  |  .  |  /  | ENT/SHFT  
//                        | GUI | RSE | SPC |         | BKSP | LWR  | ALT |
                        bindings = <
    &kp TAB       &kp Q &kp W &kp E &kp R &kp T       &kp Y &kp U  &kp I     &kp O   &kp P    &kp BSLH 
    &mt LCTRL ESC &kp A &kp S &kp D &kp F &kp G       &kp H &kp J  &kp K     &kp L   &kp SEMI &kp SQT
    &kp LSHFT     &kp Z &kp X &kp C &kp V &kp B       &kp N &kp M  &kp COMMA &kp DOT &kp FSLH &mt RSHFT RET
                         &kp LGUI &mo 2 &kp SPACE     &kp BSPC &mo 1 &kp RALT
                        >;
                };
                lower_layer {
// -----------------------------------------------------------------------------------------
// |  TAB |  !  |  @  |  #  |  $  |  %  |                      |  ^   |  &   |  *   |  (   |  )  |      |
// | BTCLR|     |     |     |     |     |                      | LFT  | DWN  |  UP  | RGT  |     |      |
// | SHFT | BT0 | BT1 | BT2 |     |     |                      |lftTab| PGdn | PGup |rgtTab|     |      |
//                    | GUI |     | SPC |                      | BKSP |      | ALT  |
                        bindings = <
   &kp TAB    &kp EXCL &kp AT &kp HASH &kp DLLR  &kp PRCNT         &kp CARET &kp AMPS &kp ASTRK &kp LPAR  &kp RPAR  &trans
   &bt BT_CLR &trans   &trans &trans   &trans    &trans            &kp LEFT  &kp DOWN &kp UP    &kp RIGHT &trans    &trans
&kp LSHFT  &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &trans &trans    &kp LS(LC(TAB)) &kp PG_DN &kp PG_UP &kp LC(TAB) &trans &trans
                   &kp LGUI     &trans       &kp SPACE             &trans  &trans    &trans
                        >;
                };

                raise_layer {
// -----------------------------------------------------------------------------------------
// |  TAB   |  1  |  2  |  3  |  4  |  5  |              |  6  |  7  |  8  |  9  |  0  | "|" |
// |CTRL/ESC|     |     |     |     |  +  |              |  (  |  [  |  {  |  -  |  =  |  `  |
// |  SHFT  |     |     |     |     |  +  |              |  )  |  ]  |  }  |  _  |  +  |  ~  |
//                      | GUI |     | SPC |              | DEL |     | ALT |
                        bindings = <
   &kp TAB      &kp N1 &kp N2 &kp N3 &kp N4 &kp N5       &kp N6   &kp N7   &kp N8   &kp N9    &kp N0    &kp PIPE
  &mt LCTRL ESC &trans &trans &trans &trans &trans       &kp LPAR &kp LBKT &kp LBRC &kp MINUS &kp EQUAL &kp GRAVE
   &kp  LSHFT   &trans &trans &trans &trans &trans       &kp RPAR &kp RBKT &kp RBRC &kp UNDER &kp PLUS  &kp TILDE
                         &kp LGUI &trans &kp SPACE       &kp DEL   &trans  &trans
                        >;
                };
        };
};
